{
  "name": "atlas-delta",
  "private": true,
  "version": "1.0.0",
  "description": "Operational data and decision platform for ingesting, transforming, versioning, and serving operational intelligence datasets",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@atlas-delta/web",
    "dev:api": "turbo run dev --filter=@atlas-delta/api",
    "test": "turbo run test",
    "test:web": "turbo run test --filter=@atlas-delta/web",
    "test:api": "turbo run test --filter=@atlas-delta/api",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:studio": "turbo run db:studio",
    "build:web": "turbo run build --filter=@atlas-delta/web",
    "build:api": "turbo run build --filter=@atlas-delta/api"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}