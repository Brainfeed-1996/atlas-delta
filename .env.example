# API Configuration
PORT=8094
NODE_ENV=development
DATABASE_URL=file:./data/atlas-delta.db
LOG_LEVEL=debug
CORS_ORIGINS=*
API_PREFIX=/api/v1
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Web Configuration
VITE_API_URL=http://localhost:8094/api/v1
VITE_WS_URL=ws://localhost:8094

